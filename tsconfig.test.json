{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["esnext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "outDir": "build-test",
    "rootDir": "./"
  },
  "include": ["ts/**/*test.ts"],
  "exclude": ["node_modules", "build"]
}
